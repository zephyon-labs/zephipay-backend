# Application
NODE_ENV=development
PORT=3001

# Set to true only when payment execution is intentionally enabled.
PAYMENTS_ENABLED=false
SYNTHETIC_BETA_IDENTITIES_ENABLED=false
BETA_ALLOWLIST_REQUIRED=true

# Durable payment storage is opt-in during Sprint 1A. DATABASE_URL is required
# only when POSTGRES_ENABLED=true. Never expose this server-only value publicly.
POSTGRES_ENABLED=false
# DATABASE_URL=postgresql://user:password@host:5432/database

# Auth is separately opt-in and requires PostgreSQL. The issuer must end in /.
AUTH_ENABLED=false
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://api.zephipay.com
AUTH0_REQUIRED_SCOPE=read:account

# Set true behind Railway or another trusted reverse proxy.
TRUST_PROXY=false

# Comma-separated browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API perimeter
JSON_BODY_LIMIT=16kb
PAYMENT_RATE_LIMIT_PER_MINUTE=5
PAYMENT_MAX_USDC=5

# Solana values are documented here without real secrets.
SOLANA_NETWORK=solana-devnet
SOLANA_RPC_URL=
SOLANA_PROGRAM_ID=
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Never commit a private key, seed phrase, or secret key here.

# Controlled Devnet integration defaults OFF. These values are server-only.
DEVNET_INTEGRATION_ENABLED=false
DEVNET_RPC_TIMEOUT_MS=5000

# READ-ONLY / RECONCILIATION (required only when reconciliation is enabled)
DEVNET_RECONCILIATION_ENABLED=false
# DEVNET_RECONCILIATION_PROVIDER_ID=solana-public-devnet-reconcile
# DEVNET_RECONCILIATION_RPC_URL=https://api.devnet.solana.com/

# PREPARATION (also requires the reconciliation settings above)
DEVNET_PREPARATION_ENABLED=false
# DEVNET_SUBMISSION_PROVIDER_ID=helius-devnet-submit
# DEVNET_PREPARATION_ENCRYPTION_KEY_BASE64=<base64-encoded-32-byte-secret>
# DEVNET_PREPARATION_ENCRYPTION_KEY_VERSION=<version>
# DEVNET_SIGNER_SECRET_KEY_BASE64=<externally-injected-base64-encoded-64-byte-devnet-secret>
# DEVNET_SIGNER_KEY_ID=<server-side-key-id>
# DEVNET_SIGNER_KEY_VERSION=<version>
# DEVNET_SIGNER_PUBLIC_KEY=<canonical-solana-public-key>
# DEVNET_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# DEVNET_MINT_DECIMALS=6
# DEVNET_SOURCE_TOKEN_ACCOUNT=<offline-derived-signer-mint-associated-token-account>

# SUBMISSION (implies preparation; keep false until separately approved)
DEVNET_SUBMISSION_ENABLED=false
# DEVNET_SUBMISSION_RPC_URL=https://devnet.helius-rpc.com/
# DEVNET_SUBMISSION_API_KEY=<raw-helius-api-key>
# E2E_DEVNET_DESTINATION_WALLET=<public-devnet-test-destination-not-ownership>
# E2E_LIVE_CANARY_CONFIRMATION=I_UNDERSTAND_THIS_SUBMITS_DEVNET_USDC
