{
  "name": "zephipay-backend",
  "version": "1.0.0",
  "description": "Backend infrastructure layer for ZephiPay beta payment execution, receipt orchestration, and future treasury services.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:postgres": "tsx --test --test-concurrency=1 tests/postgresPaymentFoundation.integration.ts tests/postgresIdentityFoundation.integration.ts tests/postgresEconomicIdentity.integration.ts tests/postgresPaymentIdentity.integration.ts tests/postgresExecution.integration.ts tests/postgresPaymentRequests.integration.ts tests/postgresOpenBetaActivity.integration.ts tests/postgresActivity.integration.ts tests/r4Invariants.integration.ts",
    "migrate": "tsx scripts/run-migrations.ts",
    "migrate:validate": "tsx scripts/validate-migrations.ts",
    "r4:stage0": "npm run build && tsx scripts/r4/run-local.ts stage0",
    "r4:smoke": "npm run build && tsx scripts/r4/run-local.ts smoke",
    "r4:baseline:read": "npm run build && tsx scripts/r4/run-local.ts baseline-read",
    "r4:baseline:write": "npm run build && tsx scripts/r4/run-local.ts baseline-write",
    "r4:stage2:read": "npm run build && tsx scripts/r4/run-local.ts stage2-read",
    "r4:fault-gates": "npm run build && tsx scripts/r4/run-local.ts fault-gates",
    "start": "node dist/server.js",
    "x402:client": "ts-node-dev --transpile-only ./scripts/x402-fetch-client.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@payai/facilitator": "^2.4.3",
    "@scure/base": "^2.2.0",
    "@solana/kit": "^5.5.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@x402/core": "^2.14.0",
    "@x402/evm": "^2.14.0",
    "@x402/express": "^2.14.0",
    "@x402/fetch": "^2.14.0",
    "@x402/svm": "^2.14.0",
    "bn.js": "^5.2.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-oauth2-jwt-bearer": "^1.9.1",
    "express-rate-limit": "^8.5.2",
    "pg": "^8.22.0",
    "viem": "^2.52.2",
    "zephyon-protocol": "github:zephyon-labs/zephyon-protocol#v0.2.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.3",
    "jose": "^6.2.7",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
