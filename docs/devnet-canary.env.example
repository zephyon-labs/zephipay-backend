# Copy values into ~/.zephipay/devnet/canary.env and chmod the file 0600.
# This is a parser-owned data file, not a shell script. Every key is required.
NODE_ENV=test
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:55432/zephipay_auth_test
E2E_DEVNET_DESTINATION_WALLET=REVIEWED_DEVNET_DESTINATION
E2E_LIVE_CANARY_CONFIRMATION=REVIEWED_LIVE_CONFIRMATION
DEVNET_INTEGRATION_ENABLED=true
DEVNET_BROWSER_API_ENABLED=true
DEVNET_PREPARATION_ENABLED=true
DEVNET_SUBMISSION_ENABLED=true
DEVNET_RECONCILIATION_ENABLED=true
DEVNET_SUBMISSION_PROVIDER_ID=helius-devnet-submit
DEVNET_SUBMISSION_RPC_URL=https://devnet.helius-rpc.com/
DEVNET_SUBMISSION_API_KEY=SECRET
DEVNET_RECONCILIATION_PROVIDER_ID=solana-public-devnet-reconcile
DEVNET_RECONCILIATION_RPC_URL=https://api.devnet.solana.com/
DEVNET_RPC_TIMEOUT_MS=5000
DEVNET_PREPARATION_ENCRYPTION_KEY_BASE64=SECRET
DEVNET_PREPARATION_ENCRYPTION_KEY_VERSION=REVIEWED_VERSION
DEVNET_SIGNER_SECRET_KEY_BASE64=SECRET
DEVNET_SIGNER_KEY_ID=REVIEWED_KEY_ID
DEVNET_SIGNER_KEY_VERSION=REVIEWED_VERSION
DEVNET_SIGNER_PUBLIC_KEY=REVIEWED_PUBLIC_KEY
DEVNET_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
DEVNET_MINT_DECIMALS=6
DEVNET_SOURCE_TOKEN_ACCOUNT=REVIEWED_SOURCE_TOKEN_ACCOUNT
